= form_with model: [ commentable, comment ], 
id: "form_#{dom_id(commentable)}_#{dom_id(comment)}",
data: { controller: "trix-form autocomplete", 
action: "trix-file-accept->trix-form#checkType trix-change->trix-form#disableSubmit" } do |f|
  = render 'notifications/error_messages', object: f.object
  - if params[:in_feed] == "1"
    = hidden_field_tag :in_feed, "1"

  .field.mb-3
    = f.label :body, 'Comment', class: "form-label"
    = f.rich_text_area :body, class: "form-control", data: { autocomplete_target: "input" }
  .actions.mb-3
    = f.submit class: 'btn btn-primary', data: { trix_form_target: "submit" }
